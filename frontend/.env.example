# Resend API Key (server-side only, used by netlify/functions/submission-created.js)
# Get your API key from https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# Shared password required to access /dashboard (server-side only)
DASHBOARD_PASSWORD=choose_a_strong_shared_password

# Secret used to HMAC-sign the dashboard session cookie (server-side only)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_hex_string

# Fallback credentials for Netlify Blobs, only needed if you hit
# MissingBlobsEnvironmentError (Netlify's automatic injection not reaching Functions).
# Site ID: Site configuration > General > Site details > Site ID
# Token: User settings > Applications > Personal access tokens > New access token
NETLIFY_SITE_ID=your_netlify_site_id
NETLIFY_BLOBS_TOKEN=your_netlify_personal_access_token
